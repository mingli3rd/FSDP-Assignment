# Copy this file to .env (same folder) and fill in your own values.
# Never commit .env. Never put a real API key in this file.

# Ports
PORT=3000
MOBILE_PORT=4000

# SQL Server (SQL Server Authentication login)
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=FSDP
DB_USER=FSDPuser
DB_PASSWORD=your_sql_password

# Any long random string, used to sign login tokens
JWT_SECRET=change_me_to_a_long_random_string

# OpenAI (for the live AI scam check)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TRANSCRIBE_MODEL=whisper-1

# Set to true to test without an API key (fake but predictable AI answers)
AI_MOCK=false
